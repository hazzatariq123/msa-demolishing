# Apache / LiteSpeed configuration for www.msademolition.com (shared hosting).
# Ships inside the build (public/ is copied into dist/). Upload dist/ including this hidden file.

Options -Indexes
DirectoryIndex index.html
# Pages live in folders (/about/index.html); serve them at /about without adding a trailing slash.
DirectorySlash Off
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/javascript .js
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) One canonical host and scheme, in a single 301: https://www.msademolition.com
  #    (also drops a trailing slash in the same hop, so there is never a redirect chain)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.msademolition\.com$ [NC]
  RewriteCond %{HTTP_HOST} msademolition\.com$ [NC]
  RewriteRule ^(.*?)/?$ https://www.msademolition.com/$1 [R=301,L,NE]

  # 2) /index.html and /about/index.html -> clean URL
  RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 3) Trailing slash -> no trailing slash (canonical URLs have none)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # 4) Serve /about from /about/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Browsers ignore HSTS on plain http, and every http request is redirected to https above
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # All .js/.css files are fingerprinted build files in /assets and never change: cache for a year
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and fonts: 30 days
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  # HTML, sitemap, robots: always revalidate so updates show immediately
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression (brotli where available, otherwise gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
